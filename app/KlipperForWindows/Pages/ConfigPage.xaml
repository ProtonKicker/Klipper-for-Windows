<Page
    x:Class="KlipperForWindows.Pages.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid RowSpacing="8" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Pivot x:Name="ConfigPivot" MaxWidth="440" HorizontalAlignment="Left" Margin="0,0,0,0">
                <PivotItem Header="printer.cfg" />
                <PivotItem Header="moonraker.conf" />
            </Pivot>
            <Button x:Name="LoadBtn" Content="Reload" Click="Load_Click" VerticalAlignment="Center" />
            <Button x:Name="SaveBtn" Content="Save" Click="Save_Click" VerticalAlignment="Center" />
            <Button x:Name="SaveRestartBtn" Content="Save &amp; restart Klipper"
                    Style="{StaticResource AccentButtonStyle}" Click="SaveRestart_Click"
                    VerticalAlignment="Center" />
            <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#E5E5E5"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="Editor"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         IsSpellCheckEnabled="False"
                         FontFamily="Consolas"
                         FontSize="13"
                         MinWidth="1100"
                         MinHeight="600"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
