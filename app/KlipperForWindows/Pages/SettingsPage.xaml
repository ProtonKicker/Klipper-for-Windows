<Page
    x:Class="KlipperForWindows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,20">
        <StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />

            <Border Background="#FFFFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Default interface" FontSize="17" FontWeight="SemiBold" />
                    <RadioButtons x:Name="UiChoice" SelectionChanged="UiChoice_SelectionChanged">
                        <RadioButton Content="Mainsail" Tag="mainsail" />
                        <RadioButton Content="Fluidd" Tag="fluidd" />
                    </RadioButtons>
                    <TextBlock Text="Which interface opens first and opens with `up --open`."
                               Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Background="#FFFFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Folders" FontSize="17" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Data folder" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="DataPath" Text="" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" />
                        <Button Grid.Column="2" Content="Open" Click="OpenData_Click" />
                        <TextBlock Grid.Row="1" Text="Runtime" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AppHomePath" Text=""
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="12" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Open" Click="OpenAppHome_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Maintenance" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check installation" Click="Doctor_Click" />
                        <Button x:Name="UpdateBtn" Content="Check for updates" Click="Update_Click" />
                        <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" />
                    </StackPanel>
                    <TextBlock x:Name="DoctorOutput" FontFamily="Consolas" FontSize="11.5"
                               TextWrapping="Wrap" MaxHeight="220" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="AboutText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
