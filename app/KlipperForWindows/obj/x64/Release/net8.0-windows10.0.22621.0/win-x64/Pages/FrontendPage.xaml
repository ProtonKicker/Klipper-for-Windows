<Page
    x:Class="KlipperForWindows.Pages.FrontendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.Web.WebView2.Core"
    Background="Transparent">

    <Grid RowSpacing="8" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ComboBox x:ConnectionId='5' x:Name="UiSwitch" MinWidth="160"                                             >
                <ComboBoxItem Content="Mainsail" Tag="mainsail" />
                <ComboBoxItem Content="Fluidd" Tag="fluidd" />
            </ComboBox>
            <Button x:ConnectionId='6' x:Name="ReloadBtn" Content="Reload"                      />
            <Button x:ConnectionId='7' x:Name="OpenExternalBtn" Content="Open in browser"                            />
            <TextBlock x:ConnectionId='8' x:Name="StatusHint" Text="" VerticalAlignment="Center"
                       Opacity="0.65" Margin="8,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E5E5"
                BorderThickness="1" CornerRadius="8">
            <Grid x:ConnectionId='2' x:Name="HostGrid">
                <ProgressRing x:ConnectionId='3' x:Name="LoadRing" Width="40" Height="40" IsActive="True" />
                <TextBlock x:ConnectionId='4' x:Name="NotRunningHint"
                           Text="The stack is not running yet. Start it from the Dashboard, then reload."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.7" TextWrapping="Wrap" MaxWidth="420"
                           TextAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>

