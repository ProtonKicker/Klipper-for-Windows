<Page
    x:Class="KlipperForWindows.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,20">
        <StackPanel Spacing="20" MaxWidth="980" HorizontalAlignment="Left">

            <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" />

            <!-- Setup banner when the runtime is missing -->
            <Border x:ConnectionId='2' x:Name="SetupBanner" Background="#FFFCE8E6" BorderBrush="#F5C6C2"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="The Klipper runtime is not installed yet."
                               FontWeight="SemiBold" />
                    <TextBlock Text="Run setup once to fetch Klipper, Moonraker, Mainsail and Fluidd. Requires Python 3.10+, Git and zig."
                               TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='30' x:Name="RunSetupBtn" Style="{StaticResource AccentButtonStyle}"
                                Content="Run setup"                        />
                        <ProgressRing x:ConnectionId='31' x:Name="SetupRing" Width="24" Height="24" IsActive="False" />
                    </StackPanel>
                    <TextBlock x:ConnectionId='29' x:Name="SetupLog" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" MaxHeight="140" />
                </StackPanel>
            </Border>

            <!-- Stack card -->
            <Border x:ConnectionId='3' Background="#FFFFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                    CornerRadius="8" Padding="18" x:Name="StackCard">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:ConnectionId='27' x:Name="StackDot" Width="11" Height="11" Fill="#9A9A9A"
                                 VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='28' x:Name="StackText" Text="Stopped" FontSize="15"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='22' x:Name="StartBtn" Style="{StaticResource AccentButtonStyle}"
                                Content="Start"                     MinWidth="96" />
                        <Button x:ConnectionId='23' x:Name="StopBtn" Content="Stop"                    MinWidth="96" />
                        <Button x:ConnectionId='24' x:Name="RestartBtn" Content="Restart"                       MinWidth="96" />
                        <Button x:ConnectionId='25' x:Name="KillBtn" Content="Force stop"                    MinWidth="96" />
                        <ProgressRing x:ConnectionId='26' x:Name="ActionRing" Width="22" Height="22" IsActive="False" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:ConnectionId='21' x:Name="DotKlipper" Width="9" Height="9" Fill="#9A9A9A" VerticalAlignment="Center" />
                            <TextBlock Text="Klipper host" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:ConnectionId='20' x:Name="DotMoonraker" Width="9" Height="9" Fill="#9A9A9A" VerticalAlignment="Center" />
                            <TextBlock Text="Moonraker API" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:ConnectionId='19' x:Name="DotMainsail" Width="9" Height="9" Fill="#9A9A9A" VerticalAlignment="Center" />
                            <TextBlock Text="Mainsail web (:8080)" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:ConnectionId='18' x:Name="DotFluidd" Width="9" Height="9" Fill="#9A9A9A" VerticalAlignment="Center" />
                            <TextBlock Text="Fluidd web (:8081)" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Ellipse x:ConnectionId='17' x:Name="DotGuard" Width="9" Height="9" Fill="#9A9A9A" VerticalAlignment="Center" />
                            <TextBlock Text="Sleep guard" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:ConnectionId='16' Grid.Row="2" Grid.Column="1" x:Name="LanText" Text="LAN access: off"
                                   VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Printer card -->
            <Border Background="#FFFFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Printer" FontSize="17" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Klipper state" Opacity="0.7" />
                        <TextBlock x:ConnectionId='9' Grid.Column="1" x:Name="KlippyState" Text="unknown" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Message" Opacity="0.7" />
                        <TextBlock x:ConnectionId='10' Grid.Row="1" Grid.Column="1" x:Name="KlippyMsg" Text=""
                                   TextWrapping="Wrap" MaxHeight="60" Opacity="0.9" />
                        <TextBlock Grid.Row="2" Text="Printer board" Opacity="0.7" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:ConnectionId='12' x:Name="PortBox" MinWidth="240" PlaceholderText="Select serial port" />
                            <Button x:ConnectionId='13' x:Name="RefreshPortsBtn" Content="Refresh"                            />
                            <Button x:ConnectionId='14' x:Name="AutoPortBtn" Content="Auto-detect"                        />
                            <Button x:ConnectionId='15' x:Name="ApplyPortBtn" Content="Apply"                        
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Current port" Opacity="0.7" />
                        <TextBlock x:ConnectionId='11' Grid.Row="3" Grid.Column="1" x:Name="CurrentPort" Text="not set" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Access card -->
            <Border Background="#FFFFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Access" FontSize="17" FontWeight="SemiBold" />
                    <ToggleSwitch x:ConnectionId='5' x:Name="LanToggle" Header="Reachable from other devices on your network"
                                                        />
                    <TextBlock x:ConnectionId='6' x:Name="LanHint" Text="Only this PC can reach the stack (localhost)."
                               Opacity="0.7" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton x:ConnectionId='7' x:Name="OpenMainsailLink" Content="Open Mainsail in browser"                            />
                        <HyperlinkButton x:ConnectionId='8' x:Name="OpenFluiddLink" Content="Open Fluidd in browser"                          />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:ConnectionId='4' x:Name="VersionText" Text="" Opacity="0.55" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>

