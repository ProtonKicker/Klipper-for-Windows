 class error(Exception):
     pass
 
+class WinSerialBridge:
+    """Bridge a pyserial COM port to a socketpair on Windows.
+
+    The C serialqueue needs a selectable fd (poll over sockets); Windows
+    COM handles are neither sockets nor CRT fds.  This wrapper owns the
+    real pyserial port, pumps bytes both ways over a loopback socketpair,
+    and hands the C side the CRT fd of one end (ReadFile/WriteFile work
+    on Winsock sockets, and the C helper's poll/fcntl shims translate CRT
+    fds back to SOCKETs for WSAPoll/ioctlsocket).
+    """
+    def __init__(self, serial_dev):
+        import socket as _socket
+        import msvcrt
+        self._serial = serial_dev
+        self._sock_local, sock_c = _socket.socketpair()
+        self._crt_fd = msvcrt.open_osfhandle(
+            sock_c.fileno(), os.O_RDWR | os.O_NOINHERIT)
+        sock_c.detach()  # the CRT fd now owns the underlying socket
+        self._stop_event = threading.Event()
+        # Wake immediately when data arrives; capped wait avoids busy spin
+        self._serial.timeout = 0.02
+        self._threads = [
+            threading.Thread(target=self._pump_to_socket, daemon=True),
+            threading.Thread(target=self._pump_to_serial, daemon=True)]
+        for t in self._threads:
+            t.start()
+    def _pump_to_socket(self):
+        # serial -> C serialqueue
+        while not self._stop_event.is_set():
+            try:
+                data = self._serial.read(4096)
+            except Exception:
+                break
+            if not data:
+                continue
+            try:
+                self._sock_local.sendall(data)
+            except OSError:
+                break
+        self._stop_event.set()
+    def _pump_to_serial(self):
+        # C serialqueue -> serial
+        self._sock_local.settimeout(0.05)
+        while not self._stop_event.is_set():
+            try:
+                data = self._sock_local.recv(4096)
+            except OSError:
+                if self._stop_event.is_set():
+                    break
+                continue
+            if not data:
+                break
+            try:
+                self._serial.write(data)
+            except Exception:
+                break
+        self._stop_event.set()
+    def fileno(self):
+        return self._crt_fd
+    def close(self):
+        self._stop_event.set()
+        for t in self._threads:
+            t.join(timeout=1.0)
+        try:
+            os.close(self._crt_fd)
+        except OSError:
+            pass
+        try:
+            self._sock_local.close()
+        except OSError:
+            pass
+        try:
+            self._serial.close()
+        except Exception:
+            pass
+
